# Host laptop: loopback; teammate: replace with host private ZeroTier/LAN IP.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=campus_app
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=campus_lost_found

# Optional verified TLS for hosted MySQL; leave disabled on an encrypted private VPN.
MYSQL_SSL=false
MYSQL_SSL_CA_FILE=

# Shared MongoDB on the host laptop. Use a database-scoped authenticated account.
# Host: 127.0.0.1; teammate: replace with the host's private ZeroTier IPv4.
# Percent-encode username/password characters in the URI. Never commit real credentials.
# Both laptops must use the SAME database name and authSource.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=campus_lost_found
# Authenticated example (replace placeholders privately):
# MONGODB_URI=mongodb://campus_app:ENCODED_PASSWORD@127.0.0.1:27017/campus_lost_found?authSource=campus_lost_found&directConnection=true

# Canonical app URL (HTTPS when exposed beyond this laptop).
APP_BASE_URL=http://localhost:3000

# Random value with at least 32 characters.
SESSION_SECRET=replace_with_a_long_random_secret_value



# Isolated audit tests use a separate local MongoDB instance, never the app database.
AUDIT_MONGODB_URI=mongodb://127.0.0.1:27018
AUDIT_TEST_PORT=3100

# Optional sample reports use two provisioned Students; passwords are never seeded.
SEED_STUDENT_EMAIL=
SEED_FINDER_EMAIL=
# College domains are registered in MySQL by the trusted Admin bootstrap or Admin UI.
