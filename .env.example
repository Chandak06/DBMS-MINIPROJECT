MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=campus_lost_found

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=campus_lost_found

# App URL for Google login.
APP_BASE_URL=http://localhost:3000

# Google OAuth settings.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google email used for the student test account.
DEMO_STUDENT_EMAIL=your_google_email@gmail.com
# Optional staff/admin test accounts.
DEMO_STAFF_EMAIL=
DEMO_ADMIN_EMAIL=

# Random value with at least 32 characters.
SESSION_SECRET=replace_with_a_long_random_secret_value



# Local demonstrations only. The initializer opts in on your local machine.
# Keep false for any externally accessible environment.
DEMO_LOGIN_ENABLED=false

# Optional integration test URL, defaults to APP_BASE_URL.
TEST_BASE_URL=http://localhost:3000
